def today_csv():
    date = datetime.datetime.now().strftime('%d-%m-%Y')
    return os.path.join("Attendance", f"Attendance_{date}.csv")

def mark_attendance(ID, name):
    now = datetime.datetime.now()
    date, t = now.strftime('%d-%m-%Y'), now.strftime('%H:%M:%S')
    path = today_csv()
    new_file = not os.path.isfile(path)
    with open(path, 'a+', newline='') as f:
        w = csv.writer(f)
        if new_file:
            w.writerow(['Id', '', 'Name', '', 'Date', '', 'Time'])
        w.writerow([ID, '', name, '', date, '', t])
    return (ID, name, date, t)

def show_today():
    for k in tv.get_children():
        tv.delete(k)
    path = today_csv()
    if not os.path.isfile(path):
        return
    d = pd.read_csv(path)
    for _, r in d.iterrows():
        tv.insert('', 0, text=str(r.iloc[0]) + '   ', values=(str(r.iloc[2]), str(r.iloc[4]), str(r.iloc[6])))

def TrackImages():
    check_haarcascadefile()
    assure_path_exists("Attendance/")
    if not os.path.isfile(MODEL_FILE):
        mess._show(title='Data Missing', message='Please click on Save Profile to train first!!')
        return
    if not os.path.isfile(STUDENT_CSV):
        mess._show(title='Details Missing', message='Students details are missing, please check!')
        return

    recognizer = cv2.face.LBPHFaceRecognizer_create()
    recognizer.read(MODEL_FILE)
    faceCascade = cv2.CascadeClassifier(cascade_path())
    df = load_students()

    cam = cv2.VideoCapture(0)
    if not cam.isOpened():
        mess._show(title='Camera error', message='Could not open the camera.')
        return
    font = cv2.FONT_HERSHEY_SIMPLEX

    # don't mark someone twice if you open "Take Attendance" again the same day
    marked = set()
    if os.path.isfile(today_csv()):
        marked = set(pd.read_csv(today_csv()).iloc[:, 0].astype(str))
    pending = []   # rows to push to Google Sheet after the camera closes

    while True:
        ret, im = cam.read()
        if not ret:
            break
        gray = cv2.cvtColor(im, cv2.COLOR_BGR2GRAY)
        faces = faceCascade.detectMultiScale(gray, 1.2, 5)
        for (x, y, w, h) in faces:
            cv2.rectangle(im, (x, y), (x + w, y + h), (225, 0, 0), 2)
            serial, conf = recognizer.predict(prep_face(gray[y:y + h, x:x + w]))
            label = 'Unknown'
            if conf < CONF_THRESHOLD:
                row = df.loc[df['SERIAL NO.'] == serial]
                if len(row):
                    ID = str(row['ID'].iloc[0])
                    label = str(row['NAME'].iloc[0])
                    if ID not in marked:
                        marked.add(ID)
                        pending.append(mark_attendance(ID, label))
            cv2.putText(im, label, (x, y + h), font, 1, (255, 255, 255), 2)
        cv2.imshow('Taking Attendance', im)
        if cv2.waitKey(1) == ord('q'):
            break
    cam.release()
    cv2.destroyAllWindows()
    show_today()

    if SHEETS_ON and pending:
        message1.configure(text="Syncing to Google Sheet...")
        window.update()
        try:
            for ID, name, date, t in pending:
                log_attendance(ID, name, date, t)
            message1.configure(text=f"Synced {len(pending)} to Google Sheet")
        except Exception as e:
            print("Sheet error:", e)
            message1.configure(text="Sheet sync failed (saved in CSV)")

