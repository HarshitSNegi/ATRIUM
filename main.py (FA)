def ImportFromFolder():
    """Register students from photos you already have.

    Folder layout:
        KnownFaces/
            101_Rahul Sharma/   <- ID_Name
                a.jpg
                b.jpg
            102_Priya Singh/
                1.png
    """
    check_haarcascadefile()
    if not os.path.isdir(KNOWN_DIR):
        os.makedirs(KNOWN_DIR)
        mess._show(title='Folder created',
                   message=f"Created '{KNOWN_DIR}'.\nInside it make one sub-folder per student named  ID_Name  "
                           f"(e.g.  101_Rahul Sharma)  and put their photos in it. Then click this button again.")
        return
    assure_path_exists("TrainingImage/")
    detector = cv2.CascadeClassifier(cascade_path())
    students, saved, skipped = 0, 0, []

    for folder in sorted(os.listdir(KNOWN_DIR)):
        fpath = os.path.join(KNOWN_DIR, folder)
        if not os.path.isdir(fpath) or '_' not in folder:
            continue
        Id, name = folder.split('_', 1)
        Id, name = Id.strip(), name.strip().replace('.', '')
        serial, _ = register_student(Id, name)
        got = 0
        for fn in sorted(os.listdir(fpath)):
            if not fn.lower().endswith(('.jpg', '.jpeg', '.png', '.bmp')):
                continue
            img = cv2.imread(os.path.join(fpath, fn))
            if img is None:
                skipped.append(f"{folder}/{fn} (unreadable)")
                continue
            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            big = max(gray.shape)
            if big > 1000:                       # shrink huge phone photos so detection is fast
                s = 1000.0 / big
                gray = cv2.resize(gray, None, fx=s, fy=s)
            found = detector.detectMultiScale(gray, 1.1, 4, minSize=(60, 60))
            if len(found) == 0:
                skipped.append(f"{folder}/{fn} (no face found)")
                continue
            x, y, w, h = max(found, key=lambda f: f[2] * f[3])   # biggest face in the photo
            stem = os.path.splitext(fn)[0].replace('.', '_')
            cv2.imwrite(os.path.join("TrainingImage", f"{name}.{serial}.{Id}.imp_{stem}.jpg"),
                        gray[y:y + h, x:x + w])
            got += 1
        if got:
            students += 1
            saved += got
            sheet_add_student(Id, name)

    update_count()
    msg = f"Imported {saved} face(s) for {students} student(s).\nNow click 'Save Profile' to train."
    if skipped:
        msg += "\n\nSkipped:\n" + "\n".join(skipped[:10])
        if len(skipped) > 10:
            msg += f"\n...and {len(skipped) - 10} more"
    mess._show(title='Import finished', message=msg)
    message1.configure(text="Photos imported  >>>  click Save Profile")

