def TrainImages():
    check_haarcascadefile()
    assure_path_exists("TrainingImageLabel/")
    recognizer = cv2.face.LBPHFaceRecognizer_create()   # needs: pip install opencv-contrib-python
    try:
        faces, ID = getImagesAndLabels("TrainingImage")
        recognizer.train(faces, np.array(ID))
    except Exception:
        mess._show(title='No Registrations', message='Please register someone first (Take Images or Import)!!!')
        return
    recognizer.save(MODEL_FILE)
    message1.configure(text="Profile Saved Successfully")
    message.configure(text='Total Registrations till now  : ' + str(len(set(ID))))

############################################################################################

def getImagesAndLabels(path):
    faces, Ids = [], []
    for f in sorted(os.listdir(path)):
        if not f.lower().endswith(('.jpg', '.jpeg', '.png')):
            continue
        try:
            ID = int(f.split(".")[1])            # serial number is the 2nd part of the filename
        except (IndexError, ValueError):
            continue
        img = np.array(Image.open(os.path.join(path, f)).convert('L'), 'uint8')
        face = prep_face(img)
        faces.append(face);                Ids.append(ID)
        faces.append(cv2.flip(face, 1));   Ids.append(ID)   # mirrored copy = extra training sample
    return faces, Ids

