def cascade_path():
    local = "haarcascade_frontalface_default.xml"
    if os.path.isfile(local):
        return local
    try:
        p = os.path.join(cv2.data.haarcascades, local)
        if os.path.isfile(p):
            return p
    except AttributeError:
        pass
    return None

def check_haarcascadefile():
    if cascade_path() is None:
        mess._show(title='Some file missing', message='haarcascade_frontalface_default.xml not found')
        window.destroy()

###################################################################################

def prep_face(gray_face):
    """Same preprocessing for training AND recognising (helps with lighting differences)."""
    return cv2.equalizeHist(cv2.resize(gray_face, FACE_SIZE))

def load_students():
    if os.path.isfile(STUDENT_CSV):
        return pd.read_csv(STUDENT_CSV)
    return pd.DataFrame(columns=STUDENT_COLUMNS)

def register_student(Id, name):
    """Adds student to StudentDetails.csv (if new). Returns (serial, is_new)."""
    assure_path_exists(STUDENT_CSV)
    df = load_students()
    match = df.loc[df['ID'].astype(str) == str(Id)]
    if len(match):
        return int(match['SERIAL NO.'].iloc[0]), False
    serial = int(df['SERIAL NO.'].max()) + 1 if len(df) else 1
    new_file = not os.path.isfile(STUDENT_CSV)
    with open(STUDENT_CSV, 'a+', newline='') as f:
        w = csv.writer(f)
        if new_file:
            w.writerow(STUDENT_COLUMNS)
        w.writerow([serial, '', Id, '', name])
    return serial, True

def update_count():
    message.configure(text='Total Registrations till now  : ' + str(len(load_students())))

def sheet_add_student(Id, name):
    if SHEETS_ON:
        try:
            add_student(Id, name)
        except Exception as e:
            print("Sheet error:", e)

