def TakeImages():
    """Register a NEW student using the laptop camera."""
    check_haarcascadefile()
    assure_path_exists("TrainingImage/")
    Id = txt.get().strip()
    name = txt2.get().strip().replace('.', '')
    if not Id:
        message.configure(text="Enter an ID first")
        return
    if not (name.isalpha() or ' ' in name):
        message.configure(text="Enter Correct name")
        return

    serial, _ = register_student(Id, name)
    cam = cv2.VideoCapture(0)
    detector = cv2.CascadeClassifier(cascade_path())
    sampleNum = 0
    while True:
        ret, img = cam.read()
        if not ret:
            break
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
        faces = detector.detectMultiScale(gray, 1.3, 5)
        for (x, y, w, h) in faces:
            cv2.rectangle(img, (x, y), (x + w, y + h), (255, 0, 0), 2)
            sampleNum += 1
            cv2.imwrite(os.path.join("TrainingImage", f"{name}.{serial}.{Id}.{sampleNum}.jpg"),
                        gray[y:y + h, x:x + w])
        cv2.imshow('Taking Images', img)
        if cv2.waitKey(100) & 0xFF == ord('q'):
            break
        elif sampleNum > 100:
            break
    cam.release()
    cv2.destroyAllWindows()
    sheet_add_student(Id, name)
    message1.configure(text="Images Taken for ID : " + Id)
    update_count()

